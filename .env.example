# Copy this file to `.env.local` for local development. Never commit real values.

# Portable database and private document storage (PostgreSQL + S3/R2/MinIO)
DATABASE_URL=postgresql://username:password@localhost:5432/beyond_disability
DATABASE_SSL=true
S3_ENDPOINT=https://s3.example.com
S3_REGION=auto
S3_BUCKET=beyond-documents
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_FORCE_PATH_STYLE=false

# Razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_MONTHLY_TOTAL_COUNT=120
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Admin authentication
ADMIN_USERNAME=info@example.org
ADMIN_PASSWORD=choose-a-strong-admin-password
ADMIN_SESSION_SECRET=generate-a-long-random-session-secret
ADMIN_NOTIFICATION_EMAIL=admin@example.org

# EmailJS password-reset and appointment messages
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_USER_TEMPLATE_ID=your_emailjs_user_template_id
EMAILJS_ADMIN_TEMPLATE_ID=your_emailjs_admin_template_id
# Optional: if blank, password reset reuses EMAILJS_ADMIN_TEMPLATE_ID.
EMAILJS_PASSWORD_RESET_TEMPLATE_ID=

# Optional Resend fallback for password-reset messages
RESEND_API_KEY=
RESEND_FROM_EMAIL=Beyond Disability <no-reply@example.org>
